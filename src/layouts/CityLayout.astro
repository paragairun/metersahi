---
// MeterSahi? - CityLayout.astro
// Single shared template for every city page. All tariff numbers,
// RTO contacts, and dates are derived from cities.json (the same
// data app.js/cities.js use at runtime) - never hand-typed here.
// Changing a shared section (GTM, CSP, cross-promo, collapsible UI)
// means editing this ONE file, not every city page.

interface RtoContact {
  label: string;
  phone: string;
  email: string;
}

interface Tariff {
  MIN_FARE?: number;
  MIN_KM?: number;
  RATE_PER_KM?: number;
  BANDS?: Array<{ upTo: number; flatFare?: number; perKm?: number }>;
  WAIT_RATE_PER_MIN: number;
  NIGHT_MULTIPLIER: number;
  NIGHT_START: number;
  NIGHT_END: number;
  LUGGAGE_PER_PIECE: number;
  TOLERANCE: number;
}

interface City {
  slug: string;
  name: string;
  state: string;
  country?: string;         // default 'India' when omitted
  countryCode?: string;     // ISO 3166-1 alpha-2, default 'IN'
  stateCode?: string;       // Indian state RTO code (MH, DL, GJ, etc.) -
  currencyCode?: string;    // ISO 4217, default 'INR'
  currencySymbol?: string;  // default '\u20b9'
  regulatorName?: string;   // default '{state} Motor Vehicles Department'
  regulatorShortName?: string; // default 'RTO'
  helplineLabel?: string;   // default 'State Transport Helpline'
  helplineHint?: string;    // default 'Toll-free'
  tariffDate: string;
  tariff: Tariff;
  taxiTariffDate?: string;
  taxiTariff?: Tariff;
  rtoContact: RtoContact[];
  onlineComplaint?: { label: string; value: string; hint: string };
  helpline: string;
  primaryVehicleType?: 'auto' | 'taxi';
}

interface Props {
  city: City;
}

const { city } = Astro.props;
const isTaxiPrimary = city.primaryVehicleType === 'taxi';
const hasTaxi = !isTaxiPrimary && !!city.taxiTariff;
const T = city.tariff;

const vehicleLabel = isTaxiPrimary ? 'Taxi' : 'Taxi & Auto Rickshaw';
const vehicleLabelShort = isTaxiPrimary ? 'taxi' : 'auto';
const vehicleMeterLabel = isTaxiPrimary ? 'Taxi' : 'Auto';

const nightPct = Math.round((T.NIGHT_MULTIPLIER - 1) * 100);
const hasNightSurcharge = T.NIGHT_MULTIPLIER > 1;
function to12Hour(hour24: number): string {
  const period = hour24 < 12 ? 'AM' : 'PM';
  let hour12 = hour24 % 12;
  if (hour12 === 0) hour12 = 12;
  return `${hour12} ${period}`;
}
const nightWindow = `${to12Hour(T.NIGHT_START)} – ${to12Hour(T.NIGHT_END)}`;
const currency = city.currencySymbol || '\u20b9';
const regulatorName = city.regulatorName || `${city.state} Motor Vehicles Department`;
const regulatorShortName = city.regulatorShortName || 'RTO';
const useIndianPlateFormat = (city.countryCode || 'IN') === 'IN';
const helplineLabel = city.helplineLabel || 'State Transport Helpline';
const helplineHint = city.helplineHint || 'Toll-free';
const isTiered = !!T.BANDS;
const isProgressive = !!T.PROGRESSIVE_BANDS;
const isBanded = isTiered || isProgressive;
const bands = isTiered ? T.BANDS! : (isProgressive ? T.PROGRESSIVE_BANDS! : []);

function fmtAmount(n: number): string {
  return Number.isInteger(n) ? String(n) : n.toFixed(2);
}
const minFareRaw = isBanded ? (bands[0].flatFare ?? bands[0].perKm) : T.MIN_FARE;
const minFareDisplay = fmtAmount(minFareRaw);
const perKmDisplay = isBanded ? bands[bands.length - 1].perKm!.toFixed(2) : T.RATE_PER_KM.toFixed(2);
const waitDisplay = T.WAIT_RATE_PER_MIN.toFixed(2);
const rateHeadline = isBanded
  ? `From ${currency}${bands[bands.length - 1].perKm}/km (tiered by distance)`
  : `${currency}${perKmDisplay}/km`;

const title = `${city.name} ${vehicleLabel} Fare Calculator — Check Meter Tampering | MeterSahi?`;
const ogTitle = `${city.name} ${vehicleMeterLabel} Fare Calculator — Is Your Meter Tampered? | MeterSahi?`;
const description = "Google maps based fare calculator. Enter your route, AI calculates distance and waiting time. Instantly displays correct fare as per official tariff.";
const keywords = `${city.name.toLowerCase()} ${vehicleLabelShort} fare calculator, ${vehicleLabelShort} fare ${city.name.toLowerCase()}, ${vehicleLabelShort} meter tampered ${city.name.toLowerCase()}, ${vehicleLabelShort} fare check ${city.name.toLowerCase()}, meter sahi, ${vehicleLabelShort} fare per km ${city.name.toLowerCase()}`;
const canonical = `https://metersahi.in/${city.slug}/`;

const webAppJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  name: `MeterSahi? — ${city.name} ${vehicleLabel} Fare Calculator`,
  url: canonical,
  description: `Free calculator to check correct ${city.name} ${vehicleLabelShort} fare per ${city.state} tariff (${city.tariffDate}). Detects tampered meters.`,
  applicationCategory: "UtilityApplication",
  offers: { "@type": "Offer", price: "0", priceCurrency: "INR" },
};

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {
      "@type": "Question",
      name: `What is the ${city.name} ${vehicleLabelShort} fare per km in ${city.tariffDate}?`,
      acceptedAnswer: {
        "@type": "Answer",
        text: isBanded
          ? `The ${city.name} ${vehicleLabelShort} fare starts at ${currency}${minFareDisplay} and is tiered by distance (down to ${currency}${perKmDisplay}/km for longer trips), per official ${city.state} tariff as of ${city.tariffDate}.`
          : `The ${city.name} ${vehicleLabelShort} fare is ${currency}${perKmDisplay}/km, with a minimum fare of ${currency}${minFareDisplay} per official ${city.state} tariff as of ${city.tariffDate}.`,
      },
    },
    {
      "@type": "Question",
      name: `How do I know if my ${city.name} ${vehicleLabelShort} meter is tampered?`,
      acceptedAnswer: {
        "@type": "Answer",
        text: `Use MeterSahi? — enter your pickup and drop and the fare charged. If the driver charges more than ${currency}${T.TOLERANCE} above the calculated correct fare, tampering is likely.`,
      },
    },
  ],
};
---
<!DOCTYPE html>
<html lang="en">
<head>
  <!-- Permissive CSP for dynamic ad networks -->
  <meta http-equiv="Content-Security-Policy" content="
    default-src 'self' https: data: 'unsafe-inline' 'unsafe-eval';
    script-src 'self' 'unsafe-inline' 'unsafe-eval' https:;
    style-src 'self' 'unsafe-inline' https:;
    font-src 'self' data: https:;
    img-src 'self' data: https:;
    connect-src 'self' https: wss:;
    frame-src 'self' https:;
    object-src 'none';
    base-uri 'self';
  "/>
  <!-- APP ANNOUNCEMENT BANNER -->
  <div class="app-banner">
    <div class="container app-banner-inner">
      <div class="app-banner-content">
        <span class="app-banner-badge">NEW</span>
        <span class="app-banner-text">
          MeterSahi is now on Android! Download the app from Google Play Store.
        </span>
      </div>
      <a 
        href="https://play.google.com/store/apps/details?id=in.metersahi.app" 
        target="_blank" 
        rel="noopener noreferrer" 
        class="app-banner-btn"
      >
        <i class="ti ti-brand-google-play"></i> Get it on Google Play
      </a>
    </div>
  </div>
  <!-- END APP ANNOUNCEMENT BANNER -->

  <!-- Google Tag Manager -->
  <script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
  new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
  j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
  'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
  })(window,document,'script','dataLayer','GTM-P4SMHLKF');</script>
  <!-- End Google Tag Manager -->
  
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>{title}</title>
  <meta name="description" content={description}/>
  <meta name="keywords" content={keywords}/>
  <link rel="canonical" href={canonical}/>
  <meta property="og:type" content="website"/>
  <meta property="og:url" content={canonical}/>
  <meta property="og:title" content={ogTitle}/>
  <meta property="og:description" content={description}/>
  <meta property="og:site_name" content="MeterSahi?"/>
  <meta name="geo.region" content="IN"/>
  <meta name="geo.placename" content={`${city.name}, ${city.state}, India`}/>
  <meta name="theme-color" content="#1a1a1a"/>

  <script type="application/ld+json" set:html={JSON.stringify(webAppJsonLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />

  <link rel="preconnect" href="https://fonts.googleapis.com"/>
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet"/>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@2.47.0/tabler-icons.min.css" integrity="sha384-PwEnNZvp50/uDLtKrd1s2D4Xe/y+fCVtEigigjik/PgHlDXUF1uJ32m7guk/XWYV" crossorigin="anonymous"/>
  <link rel="stylesheet" href="/style.css"/>

  <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-4511019454368934" crossorigin="anonymous"></script>

</head>
<body>
  <!-- Google Tag Manager (noscript) -->
  <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-P4SMHLKF" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>

  <!-- HEADER -->
  <header class="site-header">
    <div class="container">
      <div class="header-inner">
        <a href="/" class="brand">
          <span class="brand-icon">🛺</span>
          <div>
            <span class="brand-name">MeterSahi?</span>
            <span class="brand-sub">Taxi & Auto Fare Checker</span>
          </div>
        </a>
        <div class="header-right">
          <div class="tariff-badge">
            <i class="ti ti-file-certificate"></i>
            {city.state} tariff · {city.tariffDate}
          </div>
          <div class="city-dropdown">
            <button class="city-dropdown-trigger" id="city-dropdown-trigger">
              <i class="ti ti-map-pin"></i>
              {city.name}
              <i class="ti ti-chevron-down chevron"></i>
            </button>
            <div class="city-dropdown-panel" id="city-dropdown-panel">
              <div class="cd-search-wrap">
                <input class="cd-search-input" type="text" placeholder="Search city…" id="city-search-input" autocomplete="off"/>
              </div>
              <div class="cd-panel-label">Select city</div>
              <div id="city-dropdown-grid"></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </header>

  <!-- HERO -->
  <section class="hero">
    <div class="container">
      <h1 class="hero-heading">{city.name} {vehicleLabel} Fare Calculator</h1>
      <p class="hero-sub">Google maps based fare calculator. Enter your route,<strong> AI calculates distance and waiting time.</strong> Instantly displays correct fare as per official tariff.</p>
      <div class="hero-chips">
        <span class="hero-chip"><i class="ti ti-map-pin"></i> Live Google Maps routing</span>
        <span class="hero-chip"><i class="ti ti-shield-check"></i> Detects tampered meters</span>
        <span class="hero-chip"><i class="ti ti-clock"></i> Wait time calculated</span>
        {hasNightSurcharge && <span class="hero-chip"><i class="ti ti-moon"></i> Night surcharge +{nightPct}%</span>}
      </div>
    </div>
  </section>

  <!-- MAIN -->
  <main class="container main-grid" id="calculator">

    <!-- Input panel -->
    <section class="panel input-panel">
      <div class="panel-header"><span class="panel-step">1</span><h2>Your route</h2></div>
      {hasTaxi && (
        <div class="vehicle-toggle" id="vehicle-toggle" role="group" aria-label="Vehicle type">
          <button type="button" class="vt-btn active" data-vehicle="auto" onclick="setVehicleType('auto')"><i class="ti ti-scooter"></i> Auto</button>
          <button type="button" class="vt-btn" data-vehicle="taxi" onclick="setVehicleType('taxi')"><i class="ti ti-car"></i> Taxi</button>
        </div>
      )}
      <div class="field-stack">
        <div class="field">
          <label for="pickup"><i class="ti ti-map-pin"></i> Pickup</label>
          <div class="input-with-action">
            <input id="pickup" type="text" placeholder="Enter pickup location" autocomplete="off"/>
            <button type="button" class="locate-btn" id="locate-btn" onclick="useCurrentLocation()" title="Use my current location" aria-label="Use my current location">
              <i class="ti ti-current-location"></i>
            </button>
          </div>
          <span class="locate-status" id="locate-status"></span>
        </div>
        <div class="route-connector">
          <span class="connector-dot"></span>
          <span class="connector-line"></span>
          <span class="connector-dot connector-dot--end"></span>
        </div>
        <div class="field">
          <label for="dropoff"><i class="ti ti-flag"></i> Drop-off</label>
          <input id="dropoff" type="text" placeholder="Enter drop-off location" autocomplete="off"/>
        </div>
      </div>

      <div class="panel-divider"></div>
      <div class="panel-header panel-header--collapsible panel-header--tint-amber" id="ride-details-header" onclick="toggleSection('ride-details')">
        <span class="panel-step">2</span><h2>Ride details</h2><span class="optional-tag">optional</span>
        <i class="ti ti-chevron-down panel-chevron" id="ride-details-chevron"></i>
      </div>
      <div class="collapsible-content" id="ride-details-content">
      <div class="options-grid">
        <div class="field">
          <label for="ride-time"><i class="ti ti-sun"></i> Time of ride</label>
          <select id="ride-time">
            <option value="day">Day (5 AM to 12 AM)</option>
            <option value="night">Night — {nightWindow}{hasNightSurcharge && ` (+${nightPct}%)`}</option>
          </select>
        </div>
        <div class="field">
          <label for="luggage"><i class="ti ti-luggage"></i> Extra luggage</label>
          <select id="luggage">
            <option value="0">None</option>
            <option value='1'>1 piece</option><option value='2'>2 pieces</option><option value='3'>3 pieces</option>
          </select>
        </div>
      </div>

      <div class="field wait-override-field">
        <label for="actual-wait" class="wait-override-label">
          <span class="wait-override-label-text">
            <i class="ti ti-traffic-cone"></i> Actual wait time
            <span class="optional-tag">optional</span>
          </span>
          <span class="wait-toggle-wrap">
            <input type="checkbox" id="wait-override-toggle" class="wait-toggle-input"/>
            <span class="wait-toggle-track"><span class="wait-toggle-thumb"></span></span>
          </span>
        </label>
        <span class="label-hint">Know your {vehicleLabelShort} was stuck longer? Enter the actual wait time.</span>
        <div class="wait-time-inputs" id="wait-time-inputs" style="display:none">
          <div class="wait-time-input-group">
            <input id="wait-min" type="number" min="0" placeholder="0"/>
            <span class="wait-time-unit">min</span>
          </div>
          <div class="wait-time-input-group">
            <input id="wait-sec" type="number" min="0" max="59" placeholder="0"/>
            <span class="wait-time-unit">sec</span>
          </div>
        </div>
      </div>

      </div><!-- /#ride-details-content -->

      <div class="panel-divider"></div>
      <div class="panel-header panel-header--collapsible panel-header--tint-gray" id="driver-ask-header" onclick="toggleSection('driver-ask')">
        <span class="panel-step">3</span><h2>What did the driver ask?</h2><span class="optional-tag">optional</span>
        <i class="ti ti-chevron-down panel-chevron" id="driver-ask-chevron"></i>
      </div>
      <div class="collapsible-content" id="driver-ask-content">
      <div class="field actual-fare-field">
        <label for="actual-fare"><i class="ti ti-receipt"></i> Meter reading ({currency})
          <span class="label-hint">Leave blank to just see the correct fare</span>
        </label>
        <div class="rupee-input">
          <span class="rupee-symbol">{currency}</span>
          <input id="actual-fare" type="number" min="0" placeholder="e.g. 85"/>
        </div>
      </div>
      </div><!-- /#driver-ask-content -->

      <button id="calc-btn" class="btn-calculate" onclick="calculateFare()">
        <i class="ti ti-route"></i> Calculate correct fare
      </button>
      <div id="spinner" class="spinner">
        <div class="spinner-ring"></div>
        <span>Fetching live route…</span>
      </div>
    </section>

    <!-- Results panel -->
    <section class="panel results-panel" id="results-panel">
      <div id="empty-state" class="empty-state">
        <div class="empty-icon">🗺️</div>
        <p class="empty-title">Your route will appear here</p>
        <p class="empty-body">Enter pickup and drop-off, then hit Calculate to see the map and correct fare.</p>
        <div class="fare-card-preview">
          <p class="fare-card-title">{city.name} {vehicleLabelShort} tariff — {city.tariffDate}</p>
          <div class="fare-card-grid">
            <div class="fare-card-item"><span class="fc-label">{isBanded ? 'Starts at' : 'Min. fare'}</span><span class="fc-value">{currency}{minFareDisplay}</span></div>
            <div class="fare-card-item"><span class="fc-label">Per km</span><span class="fc-value">{currency}{perKmDisplay}</span></div>
            <div class="fare-card-item"><span class="fc-label">Wait/min</span><span class="fc-value">{currency}{waitDisplay}</span></div>
            {hasNightSurcharge
              ? <div class="fare-card-item"><span class="fc-label">Night +</span><span class="fc-value">{nightPct}%</span></div>
              : <div class="fare-card-item"><span class="fc-label">Tolerance</span><span class="fc-value">±{currency}{T.TOLERANCE}</span></div>}
          </div>
        </div>
      </div>

      <div id="result-content" class="result-content" style="display:none">
        <div id="map" class="map-box" aria-label="Route map"></div>
        <a href="mailto:parag.airun@gmail.com?subject=MeterSahi%20feedback" class="share-feedback-link"><i class="ti ti-message-2"></i> Share feedback</a>
        <div class="metrics-row" id="metrics-row"></div>
        <div id="verdict-box" class="verdict-box"></div>
        <div id="breakdown-box" class="breakdown-box"></div>

        <!-- Feedback -->
        <div id="feedback-section" class="feedback-section" style="display:none">
          <div class="feedback-question"><i class="ti ti-message-circle"></i><span id="feedback-question-text">Is your actual fare higher than this calculation?</span></div>
          <div class="feedback-btns">
            <button class="feedback-btn feedback-btn--no" onclick="handleFeedback('no')"><i class="ti ti-alert-triangle"></i> Report this vehicle</button>
            <button class="feedback-btn feedback-btn--yes" onclick="handleFeedback('yes')"><i class="ti ti-check"></i> It matched, no need to report</button>
          </div>
          <div id="feedback-thanks" class="feedback-thanks" style="display:none">
            <i class="ti ti-circle-check"></i> Thanks for confirming! This helps us calibrate better.
          </div>
          <div id="report-vehicle-section" class="report-vehicle-section" style="display:none">
            <div class="report-header"><i class="ti ti-alert-triangle"></i><span>Report this vehicle</span></div>
            <p class="report-subtext">Enter the {vehicleLabelShort}'s number plate to log this report.</p>
            {useIndianPlateFormat ? (
            <div class="vehicle-number-row">
              <div class="vn-group"><label class="vn-label">State</label><div class="searchable-select" id="ss-state"><input class="ss-input" type="text" placeholder={city.stateCode || 'MH'} id="vn-state-input" autocomplete="off" readonly/><div class="ss-dropdown" id="ss-state-dropdown"></div></div></div>
              <div class="vn-sep">–</div>
              <div class="vn-group"><label class="vn-label">District</label><div class="searchable-select" id="ss-district"><input class="ss-input" type="text" placeholder="01" id="vn-district-input" autocomplete="off" readonly/><div class="ss-dropdown" id="ss-district-dropdown"></div></div></div>
              <div class="vn-sep">–</div>
              <div class="vn-group"><label class="vn-label">Series</label><div class="searchable-select" id="ss-series"><input class="ss-input" type="text" placeholder="AA" id="vn-series-input" autocomplete="off" readonly/><div class="ss-dropdown" id="ss-series-dropdown"></div></div></div>
              <div class="vn-sep">–</div>
              <div class="vn-group"><label class="vn-label">Number</label><div class="searchable-select" id="ss-number"><input class="ss-input" type="text" placeholder="1234" id="vn-number-input" autocomplete="off" readonly/><div class="ss-dropdown" id="ss-number-dropdown"></div></div></div>
              <div class="vn-group vn-group--price"><label class="vn-label">Charged</label><div class="vn-price-wrap"><span class="vn-price-currency">{currency}</span><input class="vn-price-input" type="number" inputmode="decimal" min="0" placeholder="0" id="vn-price-input" autocomplete="off"/></div></div>
            </div>
            ) : (
            <div class="vehicle-number-row vehicle-number-row--plain">
              <div class="field">
                <label for="vn-plain-input" class="vn-label">{vehicleMeterLabel} registration / plate number</label>
                <input type="text" id="vn-plain-input" placeholder="e.g. TX-1234" autocomplete="off"/>
              </div>
              <div class="field vn-price-field-plain">
                <label for="vn-price-input" class="vn-label">Amount charged ({currency})</label>
                <input class="vn-price-input" type="number" inputmode="decimal" min="0" placeholder="0" id="vn-price-input" autocomplete="off"/>
              </div>
            </div>
            )}
            <button class="btn-report" id="btn-submit-report" onclick="submitReport()"><i class="ti ti-send"></i> Submit report</button>
            <div id="report-confirmation" class="report-confirmation" style="display:none"><i class="ti ti-circle-check"></i> Report submitted. Thank you!</div>
          </div>
        </div>
        <div id="ride-compare-section" class="ride-compare-section" style="display:none"></div>

        <div id="manual-fallback" class="manual-fallback" style="display:none">
          <p class="manual-title"><i class="ti ti-alert-circle"></i> Maps couldn't load the route</p>
          <p class="manual-body">Enter the distance from <a id="maps-link" href="#" target="_blank" rel="noopener">Google Maps</a> manually.</p>
          <div class="manual-inputs">
            <div class="field"><label for="manual-km">Distance (km)</label><input id="manual-km" type="number" step="0.1" min="0" placeholder="e.g. 4.2"/></div>
            <div class="field"><label for="manual-wait">Wait time (min)</label><input id="manual-wait" type="number" step="0.5" min="0" value="2"/></div>
            <button class="btn-manual" id="manual-btn">Calculate</button>
          </div>
        </div>
      </div>
    </section>
  </main>

  <!-- CROSS-PROMO -->
  <section class="cross-promo-section">
    <div class="container">
      <p class="cross-promo-label">Also from the maker of MeterSahi?</p>
      <div class="cross-promo-grid">
        <a href="https://karaokeparty.in" target="_blank" rel="noopener" class="promo-card promo-card--karaoke">
          <span class="promo-ad-badge">Ad</span>
          <span class="promo-icon">🎤</span>
          <div class="promo-text">
            <div class="promo-title">Karaoke Party <i class="ti ti-external-link"></i></div>
            <div class="promo-sub">Get scored on pitch, rhythm and technique. Challenge your friends</div>
          </div>
        </a>
        <a href="https://visitorpasses.in" target="_blank" rel="noopener" class="promo-card promo-card--visitorpasses">
          <span class="promo-ad-badge">Ad</span>
          <span class="promo-icon">🔐</span>
          <div class="promo-text">
            <div class="promo-title">VisitorPasses <i class="ti ti-external-link"></i></div>
            <div class="promo-sub">Complete digital management for housing societies</div>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- HOW IT WORKS -->
  <section class="how-it-works" id="how-it-works">
    <div class="container">
      <h2 class="section-heading">How this {city.name} {vehicleLabelShort} fare checker works</h2>
      <div class="how-grid">
        <div class="how-card"><div class="how-icon"><i class="ti ti-map-2"></i></div><h3>Live route via Google Maps</h3><p>We fetch your exact route with real-time {city.name} traffic to get accurate distance and journey time.</p></div>
        <div class="how-card"><div class="how-icon"><i class="ti ti-traffic-cone"></i></div><h3>Wait time from traffic delay</h3><p>We estimate genuine standstill time from the traffic delay on your route — the portion that accrues meter waiting charges.</p></div>
        <div class="how-card"><div class="how-icon"><i class="ti ti-calculator"></i></div><h3>Official {city.state} tariff</h3><p>{rateHeadline} + {currency}{waitDisplay}/min wait + night surcharge, exactly as per {city.tariffDate} rates.</p></div>
        <div class="how-card"><div class="how-icon"><i class="ti ti-shield-check"></i></div><h3>±{currency}{T.TOLERANCE} tolerance band</h3><p>Meters can differ by a few rupees due to rounding. Only differences beyond {currency}{T.TOLERANCE} are flagged as tampering.</p></div>
      </div>
    </div>
  </section>

  <!-- TARIFF TABLE -->
  <section class="tariff-section" id="tariff">
    <div class="container" data-nosnippet>
      <h2 class="section-heading">{city.name} {vehicleMeterLabel} Fare Chart {city.tariffDate}</h2>
      <p class="section-sub">Official rates as per {regulatorName} — <strong>{city.tariffDate}</strong></p>
      <div class="tariff-table-wrap">
        <table class="tariff-table">
          <thead><tr><th>Component</th><th>Rate</th><th>Notes</th></tr></thead>
          <tbody>
            {isBanded ? (
              bands.map((band, i) => {
                const prevUpTo = i === 0 ? 0 : bands[i - 1].upTo;
                const range = band.upTo >= 99999 ? `${prevUpTo} km+` : `${prevUpTo} - ${band.upTo} km`;
                const rate = band.flatFare !== undefined ? `${currency}${band.flatFare} flat` : `${currency}${band.perKm} / km`;
                const note = band.flatFare !== undefined
                  ? 'Flat fare for this range'
                  : (isProgressive ? 'Applies only to this portion of the trip' : 'Applied to full trip distance');
                return <tr><td>Distance {range}</td><td>{rate}</td><td>{note}</td></tr>;
              })
            ) : (
              <>
                {T.FLAG_FALL ? (
                  <>
                    <tr><td>Flag-fall</td><td>{currency}{fmtAmount(T.FLAG_FALL)}</td><td>Fixed charge per trip</td></tr>
                    <tr><td>Per km rate</td><td>{currency}{perKmDisplay} / km</td><td>Applied to full distance</td></tr>
                    <tr><td>Minimum fare</td><td>{currency}{fmtAmount(T.MIN_FARE)}</td><td>Floor for short trips</td></tr>
                  </>
                ) : (
                  <>
                    <tr><td>Minimum fare</td><td>{currency}{T.MIN_FARE}</td><td>First {T.MIN_KM} km</td></tr>
                    <tr><td>Per km rate</td><td>{currency}{perKmDisplay} / km</td><td>Beyond {T.MIN_KM} km</td></tr>
                  </>
                )}
              </>
            )}
            <tr><td>Waiting charge</td><td>{currency}{waitDisplay} / min</td><td>Vehicle stationary</td></tr>
            {hasNightSurcharge && <tr><td>Night surcharge</td><td>+{nightPct}%</td><td>{nightWindow}</td></tr>}
            <tr><td>Luggage</td><td>{currency}{T.LUGGAGE_PER_PIECE}/piece</td><td>Oversized items</td></tr>
            <tr><td>Tolerance band</td><td>±{currency}{T.TOLERANCE}</td><td>Acceptable meter rounding</td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="faq-section" id="faq">
    <div class="container">
      <h2 class="section-heading">Frequently asked questions — {city.name} {vehicleLabelShort}s</h2>
      <div class="faq-list">
        <details class="faq-item">
          <summary class="faq-q">What is the {city.name} {vehicleLabelShort} fare per km in {city.tariffDate}?</summary>
          <div class="faq-a">{isBanded ? (<>The fare is <strong>tiered by distance</strong>, starting at {currency}{minFareDisplay} and dropping to <strong>{currency}{perKmDisplay}/km</strong> for longer trips, as per {regulatorName} ({city.tariffDate}). See the fare chart above for the full breakdown.</>) : (<>The rate is <strong>{currency}{perKmDisplay}/km</strong> as per {regulatorName} ({city.tariffDate}). {T.FLAG_FALL ? (<>There's a {currency}{fmtAmount(T.FLAG_FALL)} flag-fall per trip, with a {currency}{fmtAmount(T.MIN_FARE)} minimum for short trips.</>) : (<>The minimum fare is {currency}{T.MIN_FARE} for the first {T.MIN_KM} km.</>)}</>)}</div>
        </details>
        <details class="faq-item">
          <summary class="faq-q">How do I know if my {city.name} {vehicleLabelShort} meter is tampered?</summary>
          <div class="faq-a">Use MeterSahi? — enter your pickup, drop, and the fare charged. If the driver's fare exceeds the calculated correct fare by more than {currency}{T.TOLERANCE}, tampering is likely. Signs include fares that seem very high for a short distance.</div>
        </details>
        {hasNightSurcharge && (
        <details class="faq-item">
          <summary class="faq-q">What is the night surcharge for {city.name} {vehicleLabelShort}s?</summary>
          <div class="faq-a">A <strong>{nightPct}% night surcharge</strong> applies to all rides between <strong>{nightWindow}</strong>.</div>
        </details>
        )}
        <details class="faq-item">
          <summary class="faq-q">How do I complain about a tampered {vehicleLabelShort} meter in {city.name}?</summary>
          <div class="faq-a">Call the helpline <strong>{city.helpline}</strong> or contact your nearest {regulatorShortName} office with the {vehicleLabelShort}'s number plate and trip details.</div>
        </details>
        <details class="faq-item">
          <summary class="faq-q">Is MeterSahi? free to use?</summary>
          <div class="faq-a">Yes, completely free. No registration or app download needed.</div>
        </details>
      </div>
    </div>
  </section>

  <!-- COMPLAINT -->
  <section class="complaint-section" id="complaint">
    <div class="container">
      <div class="complaint-inner">
        <div class="complaint-text">
          <h2>{vehicleMeterLabel} meter tampered? How to complain in {city.name}</h2>
          <p>Every report helps clean up the system.</p>
        </div>
        <div class="complaint-options">
        <div class="complaint-card">
          <i class="ti ti-phone"></i>
          <span class="cc-label">{helplineLabel}</span>
          <span class="cc-value">{city.helpline}</span>
          <span class="cc-hint">{helplineHint}</span>
        </div>
        {city.rtoContact.map((rto) => (
          <div class="complaint-card">
            <i class="ti ti-building-bank"></i>
            <span class="cc-label">{rto.label}</span>
            <span class="cc-value">{rto.phone || 'Not published'}</span>
            <span class="cc-hint">{rto.email || '—'}</span>
          </div>
        ))}
        {city.onlineComplaint && (
          <div class="complaint-card">
            <i class="ti ti-device-laptop"></i>
            <span class="cc-label">{city.onlineComplaint.label}</span>
            <span class="cc-value">{city.onlineComplaint.value}</span>
            <span class="cc-hint">{city.onlineComplaint.hint}</span>
          </div>
        )}
        </div>
      </div>
    </div>
  </section>

